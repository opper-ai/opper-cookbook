# ---------------------------------------------------------------------------
# Media Studio configuration
# ---------------------------------------------------------------------------

# Quick start: paste an Opper API key and the studio runs against your own
# Opper account. Get one at https://platform.opper.ai
OPPER_API_KEY=op-...

# Opper API base URL (override for self-hosted / staging).
OPPER_BASE_URL=https://api.opper.ai

# Port to serve the studio on (auto-increments if taken).
PORT=3000

# ---------------------------------------------------------------------------
# Login with Opper (optional — leave blank to use OPPER_API_KEY above)
# ---------------------------------------------------------------------------
# When CLIENT_ID/CLIENT_SECRET are set, the studio shows a "Login with Opper"
# button and bills generations from each visitor's own Opper Wallet instead of
# your single key. Register an OAuth client to get these.
# CLIENT_ID=
# CLIENT_SECRET=
